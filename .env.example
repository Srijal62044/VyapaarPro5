# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FamGateway In-Page Payment Gateway (Vercel Environment Variables)
FAMGATEWAY_API_KEY=your_famgateway_api_key_here
FAMGATEWAY_MERCHANT_ID=your_famgateway_merchant_id
FAMGATEWAY_UPI_VPA=your_merchant_vpa@upi
FAMGATEWAY_MERCHANT_NAME=VyapaarPro
FAMGATEWAY_WEBHOOK_SECRET=your_webhook_secret_here

# Site URL Configuration
VITE_PUBLIC_SITE_URL=https://your-domain.vercel.app
PUBLIC_SITE_URL=https://your-domain.vercel.app
