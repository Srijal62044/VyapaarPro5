{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-FamGateway-Signature, X-Signature, X-Api-Key"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/payments/famgateway/webhook",
      "destination": "/api/famgateway-webhook"
    },
    {
      "source": "/api/store/admin/review-order",
      "destination": "/api/store/[...route]?route=admin/review-order"
    },
    {
      "source": "/api/store/payment/verify",
      "destination": "/api/store/[...route]?route=payment/verify"
    },
    {
      "source": "/api/store/download",
      "destination": "/api/store/[...route]?route=download"
    },
    {
      "source": "/api/support/(.*)",
      "destination": "/api/support/[...route]?route=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
